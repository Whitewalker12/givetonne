{
  "name": "givetonne",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:setup": "prisma db push && prisma db seed",
    "vercel-build": "prisma generate && prisma db push --accept-data-loss && prisma db seed && next build",
    "db:dev": "prisma dev --name givetonne",
    "chain:compile": "tsx scripts/compile-contract.ts",
    "chain:deploy": "tsx scripts/deploy-contract.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "nanoid": "^6.0.2",
    "next": "16.4.2",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.34.1",
    "viem": "^2.57.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "solc": "^0.8.28",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
