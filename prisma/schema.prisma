generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A carbon project the gifter can choose from (mirrors a registry entry).
model Project {
  id             String   @id
  name           String
  location       String
  type           String // e.g. "Reforestation", "Clean cookstoves"
  registry       String // e.g. "Verra VCS"
  registryId     String // registry project id
  vintage        Int
  pricePerTonne  Int // cents
  description    String
  imageEmoji     String
  availableTonnes Float
  gifts          Gift[]
}

/// One gift order: the gifter's intent, payment, and the resulting retirement.
model Gift {
  id             String   @id
  slug           String   @unique
  giverName      String
  giverEmail     String
  recipientName  String
  recipientEmail String?
  message        String
  tonnes         Float
  amountCents    Int
  status         String // "pending_payment" | "retiring" | "delivered" | "failed"
  createdAt      DateTime @default(now())
  paymentId      String?
  claimToken     String   @unique
  deliverAt      DateTime? // null = send certificate email right after payment
  deliveredAt    DateTime? // when the recipient email went out

  projectId      String
  project        Project  @relation(fields: [projectId], references: [id])
  retirement     Retirement?
  emails         EmailLog[]
}

/// Every email we send (or would send, when no RESEND_API_KEY is set).
model EmailLog {
  id        String   @id
  giftId    String
  gift      Gift     @relation(fields: [giftId], references: [id])
  kind      String // "receipt" | "certificate"
  to        String
  subject   String
  provider  String // "resend" | "console"
  messageId String?
  sentAt    DateTime @default(now())
}

/// The on-chain retirement record (mocked in the demo, Toucan/Klima later).
model Retirement {
  id              String   @id
  giftId          String   @unique
  gift            Gift     @relation(fields: [giftId], references: [id])
  chain           String // "mock-polygon-amoy"
  txHash          String   @unique
  blockNumber     Int
  contract        String
  beneficiaryName String
  beneficiaryMsg  String
  tonnes          Float
  serialRange     String // registry serial numbers retired
  certTokenId     Int // retirement certificate NFT id
  claimedBy       String? // wallet address once the NFT is claimed
  retiredAt       DateTime @default(now())
}

/// Simulated chain ledger (demo only). Lives in the DB so it survives on
/// serverless hosts; it is still a separate table the /verify page cross-checks.
model MockLedgerEntry {
  txHash          String   @id
  blockNumber     Int      @unique
  contract        String
  serialRange     String
  certTokenId     Int      @unique
  beneficiaryName String
  beneficiaryMsg  String
  tonnes          Float
  claimedBy       String?
  retiredAt       DateTime @default(now())
}
